# 复制为 .env 后按需修改；docker compose 会自动加载

# 服务端口
PORT=8080

# SQLite 数据库（WAL 模式，单文件持久化）
DATABASE_URL=sqlite:///app/data/schedule.db?mode=rwc

# 后台轮询官方公告的间隔（小时）
SYNC_INTERVAL_HOURS=6

# 容器启动 5 秒后是否立即执行一次官方同步
SYNC_ON_START=true

# 写接口（POST /api/sync、POST/DELETE /api/override）的 Bearer Token；
# 留空则不做鉴权。个人服务器建议设置强口令：
#   ADMIN_TOKEN=please-change-me
ADMIN_TOKEN=

# 米游社 getNewsList 候选 API 域名（逗号分隔，依次尝试）
MIYOUSHE_API_BASES=https://bbs-api.miyoushe.com,https://api-takumi.mihoyo.com,https://bbs-api-static.miyoushe.com

# 容器时区
TZ=Asia/Shanghai

# 本地开发：前端产物目录（Docker 内固定为 web/dist）
WEB_DIST=web/dist
